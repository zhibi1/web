<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>用户注册页面</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header>
        <h1>用户注册</h1>
    </header>
    <main>
        <!-- 有序列表：注册步骤 -->
        <h2>注册步骤</h2>
        <ol>
            <li>填写个人信息</li>
            <li>阅读注册须知</li>
            <li>提交表单完成注册</li>
        </ol>

        <!-- 无序列表：注意事项 -->
        <h2>注册注意事项</h2>
        <ul>
            <li>用户名不可重复</li>
            <li>密码长度6-16位</li>
            <li>手机号必须为11位数字</li>
        </ul>

        <!-- 定义列表：常见问题 -->
        <h2>常见问题</h2>
        <dl>
            <dt>注册失败怎么办？</dt>
            <dd>检查表单是否全部按要求填写。</dd>
            <dt>收不到邮箱验证码？</dt>
            <dd>查看垃圾邮件文件夹。</dd>
        </dl>

        <!-- 表格：注册须知，包含合并单元格 -->
        <h2>注册须知</h2>
        <table border="1">
            <thead>
                <tr>
                    <th colspan="2">会员权益说明</th>
                </tr>
                <tr>
                    <th>项目</th>
                    <th>权益</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>普通会员</td>
                    <td>基础浏览权限</td>
                </tr>
                <tr>
                    <td>高级会员</td>
                    <td>全部功能访问</td>
                </tr>
            </tbody>
        </table>

        <!-- 注册表单 -->
        <form id="registerForm">
            <p>
                <label for="username">用户名：</label>
                <input type="text" name="username" id="username" required>
            </p>
            <p>
                <label for="password">密码：</label>
                <input type="password" name="password" id="password" placeholder="6-16位字符">
            </p>
            <p>
                <label for="confirmPassword">确认密码：</label>
                <input type="password" name="confirmPassword" id="confirmPassword">
            </p>
            <p>
                性别：
                <input type="radio" name="gender" id="male" value="male">
                <label for="male">男</label>
                <input type="radio" name="gender" id="female" value="female">
                <label for="female">女</label>
            </p>
            <p>
                <label for="birthday">出生日期：</label>
                <input type="date" name="birthday" id="birthday">
            </p>
            <p>
                <label for="email">邮箱：</label>
                <input type="email" name="email" id="email" required>
            </p>
            <p>
                <label for="phone">手机号：</label>
                <input type="tel" name="phone" id="phone" pattern="[0-9]{11}">
            </p>
            <p>
                兴趣爱好：
                <input type="checkbox" name="hobby" value="reading" id="read">
                <label for="read">阅读</label>
                <input type="checkbox" name="hobby" value="sport" id="sport">
                <label for="sport">运动</label>
                <input type="checkbox" name="hobby" value="music" id="music">
                <label for="music">音乐</label>
            </p>
            <p>
                <label for="avatar">上传头像（可多选图片）：</label>
                <input type="file" name="avatar" id="avatar" accept="image/*" multiple>
            </p>
            <p>
                <label for="city">所在城市：</label>
                <select name="city" id="city">
                    <option value="changde" selected>常德</option>
                    <option value="changsha">长沙</option>
                    <option value="wuhan">武汉</option>
                </select>
            </p>
            <p>
                <label for="bio">个人简介：</label><br>
                <textarea name="bio" id="bio" rows="4" cols="50"></textarea>
            </p>
            <p>
                <button type="submit">注册</button>
                <button type="reset">重置</button>
            </p>
        </form>
    </main>
    <footer>
        <p>©2026 用户注册系统 版权所有</p>
    </footer>

    <script>
        const form = document.getElementById('registerForm');
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            // 密码一致性校验
            const pwd = document.getElementById('password').value;
            const pwd2 = document.getElementById('confirmPassword').value;
            if(pwd !== pwd2){
                alert("两次输入密码不一致！");
                return;
            }
            // 收集表单数据
            const formData = new FormData(form);
            const dataObj = {};
            formData.forEach((val, key)=>{
                dataObj[key] = val;
            });
            console.log("表单收集数据：", dataObj);
            alert("提交成功，请查看控制台打印数据！");
        })
    </script>
</body>
</html>
